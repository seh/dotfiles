#!/usr/bin/env bash

# Write one file for each kitty theme, holding that theme's preview
# page with its colors already resolved into escape sequences. The
# "render-theme" program prints one of these; it reads no theme file
# and does no color work of its own.
#
# A file begins with the page background and then its foreground, each
# on its own line as "red;green;blue". Every line after those two is
# one line of the page: three characters holding the width a reader
# sees, and then the text with its escape sequences. Stating the width
# here spares the printing program from measuring text it would have to
# strip escape sequences out of first, and giving it a fixed size
# spares that program from looking for a separator.
#
# Nix supplies the directory of theme files, the program that reads
# their colors, and the output directory.

set -o errexit -o nounset -o pipefail
shopt -s extglob nullglob

# shellcheck disable=SC2154 # Set by Nix when invoking this program.
readonly themes_dir="${themesDir}"
# shellcheck disable=SC2154 # Set by Nix when invoking this program.
readonly resolve_colors="${resolveColors}"
# shellcheck disable=SC2154 # Set by Nix when invoking this program.
readonly output_dir="${out}"

# How wide the warning lines are allowed to run. The sentences below
# are written to this width, and the list of settings a theme states is
# cut to match.
readonly warning_width=44

theme_files=("${themes_dir}"/*.conf)
if [ "${#theme_files[@]}" -eq 0 ]; then
  echo >&2 "No \".conf\" files in the \"${themes_dir}\" directory."
  exit 1
fi
mkdir --parents "${output_dir}"

# Ask kitty what every stated color means, for every theme at once.
# Kitty accepts more forms than "#rrggbb" — a color name, three
# hexadecimal digits, twelve of them, "rgb:rr/gg/bb" — and reading
# them here would mean keeping a second copy of its table and its
# rules. A value kitty does not accept comes back with an empty
# reading, and the page for that theme says so.
declare -A read_as=() stated_as=()
while IFS=$'\t' read -r theme setting stated reading; do
  if [ -n "${reading}" ]; then
    read_as["${theme}"$'\t'"${setting}"]="${reading}"
  else
    stated_as["${theme}"]+="${setting}=${stated} "
  fi
done < <(kitty +launch "${resolve_colors}" "${themes_dir}")

widths=()
for theme_file in "${theme_files[@]}"; do
  theme_name="${theme_file##*/}"
  theme_name="${theme_name%.conf}"

  declare -A shade=()
  for setting in background foreground color{0..15}; do
    reading="${read_as["${theme_name}"$'\t'"${setting}"]-}"
    if [ -n "${reading}" ]; then
      shade["${setting}"]="${reading}"
    fi
  done
  unreadable=("${stated_as["${theme_name}"]-}")

  # A theme that states no foreground or background would leave the
  # page unreadable, so stand in for whatever it omits.
  : "${shade[foreground]:=192;192;192}"
  : "${shade[background]:=0;0;0}"
  for index in {0..15}; do
    : "${shade[color${index}]:=${shade[foreground]}}"
  done

  # Every escape sequence the page needs, built once. Nothing below
  # runs a command substitution, so composing 409 pages costs no
  # processes beyond this one.
  declare -A ink=() paper=()
  for index in {0..15}; do
    ink[${index}]=$'\033[38;2;'"${shade[color${index}]}"'m'
    paper[${index}]=$'\033[48;2;'"${shade[color${index}]}"'m'
  done
  page_background=$'\033[48;2;'"${shade[background]}"'m'
  page_foreground=$'\033[38;2;'"${shade[foreground]}"'m'

  swatches=''
  for index in {0..7}; do
    swatches+="${paper[${index}]}  "
  done
  swatches+="${page_background}  "
  for index in {8..15}; do
    swatches+="${paper[${index}]}  "
  done

  named=''
  for index in 1 2 3 4 5 6; do
    named+="${ink[${index}]}text "
  done

  bright=''
  for index in 9 10 11 12 13 14; do
    bright+="${ink[${index}]}text "
  done

  warning_lines=()
  if [ -n "${unreadable[*]}" ]; then
    stated="${unreadable[*]% }"
    # A theme states these values, so their length is not ours to
    # choose. Left whole, a long one would wrap and push the page off
    # the foot of the pane.
    if [ "${#stated}" -gt "${warning_width}" ]; then
      stated="${stated:0:warning_width-3}..."
    fi
    warning_lines=(
      "${ink[3]}Kitty cannot read these settings:"
      "${ink[3]}  ${stated}"
      "${ink[3]}The foreground stands in for them below, and"
      "${ink[3]}kitty will stand in for them too when this"
      "${ink[3]}theme is applied."
      ''
    )
  fi

  page=(
    "${warning_lines[@]}"
    "${swatches}"
    ''
    "${named}"
    "${bright}"
    ''
    "${ink[4]}function ${ink[3]}reticulate${ink[15]}(count int) {"
    "${ink[8]}  // Splines are reticulated in place."
    "${ink[15]}  log.${ink[3]}Printf${ink[15]}(${ink[2]}\"spline %d\"${ink[15]}, i)"
    "${ink[15]}}"
    ''
    "${ink[6]}@@ -14,7 +14,7 @@"
    "${ink[1]}-  the line that was there before"
    "${ink[2]}+  the line that stands in its place"
    ''
    "${ink[2]}INFO${ink[15]}  listening on port ${ink[5]}8080"
    "${ink[3]}WARN${ink[15]}  retrying in ${ink[5]}2s"
    "${ink[1]}ERROR${ink[15]} connection refused"
  )

  # Measuring a line means taking the escape sequences back out of it,
  # which is the most expensive thing this program does. The text a
  # reader sees is the same in every theme, so the widths are measured
  # for the first page and reused for the rest. A page that opens with
  # a warning states that theme's own settings, so it is measured on
  # its own.
  if [ "${#warning_lines[@]}" -gt 0 ] || [ "${#widths[@]}" -eq 0 ]; then
    measured=()
    for content in "${page[@]}"; do
      visible="${content//$'\033['*([0-9;])m/}"
      # The leading space belongs to the line, so it counts toward the
      # width a reader sees.
      measured+=("$((${#visible} + 1))")
    done
    if [ "${#warning_lines[@]}" -eq 0 ]; then
      widths=("${measured[@]}")
    fi
  else
    measured=("${widths[@]}")
  fi

  {
    printf '%s\n%s\n' "${shade[background]}" "${shade[foreground]}"
    for index in "${!page[@]}"; do
      printf '%3d%s%s %s\n' \
        "${measured[${index}]}" "${page_background}" "${page_foreground}" "${page[${index}]}"
    done
  } >"${output_dir}/${theme_name}"
done
